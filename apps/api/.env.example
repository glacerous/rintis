# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Server Configuration (optional)
PORT=8080
ENV=development

# Stage 2 — Condition Reports Pipeline
# Firecrawl API key — https://firecrawl.dev
FIRECRAWL_API_KEY=
# Groq inference API key — https://console.groq.com
GROQ_API_KEY=

# Stage 3 — Discovery Pipeline
# TinyFish API key — https://tinyfish.ai
TINYFISH_API_KEY=

# Stage 4 — YouTube Audio transcription
# AssemblyAI API key — https://assemblyai.com
ASSEMBLYAI_API_KEY=

